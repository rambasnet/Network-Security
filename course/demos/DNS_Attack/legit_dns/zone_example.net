$TTL 3D
@       IN      SOA   ns.example.net. admin.example.net. (
                2025101101  ; Serial
                8H          ; Refresh
                2H          ; Retry
                4W          ; Expire
                1D)         ; Minimum TTL

@       IN      NS    ns.example.net.
ns      IN      A     10.9.0.54            ; this legitimate name server

; The genuine records a client SHOULD get when the attack is NOT running.
; 93.184.216.34 is the well-known "example" address (the real site).
@       IN      A     93.184.216.34
www     IN      A     93.184.216.34
mail    IN      A     93.184.216.35
